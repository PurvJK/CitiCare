# Server
PORT=5000

# MongoDB (local or Atlas connection string)
MONGODB_URI=mongodb+srv://ayushvekariya33_db_user:iYFj1mBMgeDkwDxj@cluster0.ukdq7ky.mongodb.net/citicare

# JWT (use a strong secret in production)
JWT_SECRET=ayush@
JWT_EXPIRES_IN=7d

# Frontend URL - where the React app runs (for CORS). Must match your frontend dev server.
# If frontend runs on port 8080 use http://localhost:8080
CLIENT_URL=http://localhost:8080

# Backend base URL - used for building image URLs (avatars, complaint images) in API responses
API_BASE_URL=http://localhost:5000

# Where to store uploaded files (relative to backend folder)
UPLOAD_DIR=./uploads

# AI draft helper
AI_FEATURE_DRAFT_HELPER=true
AI_FEATURE_IMAGE_HELPER=true
AI_TIMEOUT_MS=8000
AI_PROVIDER=gemini

# Gemini settings
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_VISION=gemini-2.0-flash
GEMINI_API_KEY=replace-with-your-gemini-key
